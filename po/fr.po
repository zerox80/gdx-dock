#: dock/appMenu.js:55 dock/appMenu.js:58
msgid "Move right"
msgstr "Déplacer à droite"

#: dock/appMenu.js:55 dock/appMenu.js:58
msgid "Move left"
msgstr "Déplacer à gauche"

#: dock/appMenu.js:64
msgid "Close all windows"
msgstr "Fermer toutes les fenêtres"

#: dock/appStrip.js:89
msgid "Your apps · pin them from search"
msgstr "Vos applications · épinglez-les depuis la recherche"

#: dock/workspaces.js:30
#, javascript-format
msgid "Workspace %d"
msgstr "Espace de travail %d"

#: search/launcher.js:18
msgid "Search apps"
msgstr "Rechercher des applications"

#: search/launcher.js:23
msgid "Apps"
msgstr "Applications"

#: search/launcher.js:50
msgid "A great start."
msgstr "Un bon départ."

#: search/launcher.js:51
msgid "Your apps. One place."
msgstr "Vos applications. Un seul endroit."

#: search/launcher.js:54
msgid "GDX Dock settings"
msgstr "Paramètres de GDX Dock"

#: search/launcher.js:64
msgid "Search for an app…"
msgstr "Rechercher une application…"

#: search/launcher.js:71
msgid "All apps"
msgstr "Toutes les applications"

#: search/launcher.js:71
