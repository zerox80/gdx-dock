#: dock/appButton.js:90
#, javascript-format
msgid "%s — windows: %d"
msgstr "%s — окна: %d"

#: dock/appMenu.js:34
msgid "Open"
msgstr "Открыть"

#: dock/appMenu.js:36
msgid "New window"
msgstr "Новое окно"

#: dock/appMenu.js:45 search/launcher.js:212
msgid "Unpin from dock"
msgstr "Открепить от дока"

#: dock/appMenu.js:45 search/launcher.js:212
msgid "Pin to dock"
msgstr "Закрепить в доке"

#: dock/appMenu.js:55 dock/appMenu.js:58
msgid "Move right"
msgstr "Переместить вправо"

#: dock/appMenu.js:55 dock/appMenu.js:58
msgid "Move left"
msgstr "Переместить влево"

#: dock/appMenu.js:64
msgid "Close all windows"
msgstr "Закрыть все окна"

#: dock/appStrip.js:89
msgid "Your apps · pin them from search"
msgstr "Ваши приложения · закрепляйте их через поиск"

#: dock/workspaces.js:30
#, javascript-format
msgid "Workspace %d"
msgstr "Рабочее место %d"

#: search/launcher.js:18
msgid "Search apps"
msgstr "Поиск приложений"

#: search/launcher.js:23
msgid "Apps"
msgstr "Приложения"

#: search/launcher.js:51
msgid "A great start."
msgstr "Отличное начало."

#: search/launcher.js:52
msgid "Your apps. One place."
msgstr "Ваши приложения. В одном месте."

#: search/launcher.js:55
msgid "GDX Dock settings"
msgstr "Настройки GDX Dock"

#: search/launcher.js:65
msgid "Search for an app…"
msgstr "Найти приложение…"

#: search/launcher.js:72
msgid "All apps"
msgstr "Все приложения"

#: search/launcher.js:72
msgid "Pinned"
msgstr "Закреплённые"

#: search/launcher.js:72 search/launcher.js:202
msgid "Running"
msgstr "Запущенные"

#: search/launcher.js:93
msgid "Up/Down: Select; Enter: Open"
msgstr "Вверх/Вниз: выбор; Enter: открыть"

#: search/launcher.js:94
msgid "Super · App menu"
msgstr "Super · Меню приложений"

#: search/launcher.js:187
#, javascript-format
msgid "Results: %d"
msgstr "Результаты: %d"

#: search/launcher.js:187
#, javascript-format
msgid "Apps: %d"
msgstr "Приложения: %d"

#: search/launcher.js:202
msgid "Application"
msgstr "Приложение"

#: search/launcher.js:212
#, javascript-format
msgid "%s: %s"
msgstr "%s: %s"

#: search/launcher.js:230
msgid "No matching apps."
msgstr "Подходящих приложений нет."

#: search/launcher.js:230
msgid "Nothing here yet."
msgstr "Здесь пока ничего нет."

#: search/launcher.js:232
msgid "Try another name or search term."
msgstr "Попробуйте другое название или поисковый запрос."

#: search/launcher.js:232
msgid "Use the star to pin apps to your dock."
msgstr "Используйте звёздочку, чтобы закрепить приложения в доке."

#: search/launcher.js:237
msgid "Search to find more apps."
msgstr "Используйте поиск, чтобы найти другие приложения."

#: preferences/page.js:9
msgid "Appearance"
msgstr "Внешний вид"

#: preferences/page.js:10
msgid "Changes apply immediately."
msgstr "Изменения применяются сразу."

#: preferences/page.js:11
msgid "Icon size"
msgstr "Размер значков"

#: preferences/page.js:11
msgid "Small to large"
msgstr "От маленьких до больших"

#: preferences/page.js:15
msgid "Text size"
msgstr "Размер текста"

#: preferences/page.js:15
msgid "Percent of the default size"
msgstr "Процент от размера по умолчанию"

#: preferences/page.js:19
msgid "System icon size"
msgstr "Размер системных значков"

#: preferences/page.js:20
msgid "Wi-Fi, sound, battery and other status icons"
msgstr "Wi-Fi, звук, батарея и другие значки состояния"

#: preferences/page.js:24
msgid "Opacity"
msgstr "Непрозрачность"

#: preferences/page.js:24
msgid "Percent"
msgstr "Проценты"

#: preferences/page.js:29
msgid "Accent color"
msgstr "Акцентный цвет"

#: preferences/page.js:30
msgid "Mint"
msgstr "Мятный"

#: preferences/page.js:30
msgid "Lilac"
msgstr "Сиреневый"

#: preferences/page.js:30
msgid "Blue"
msgstr "Синий"

#: preferences/page.js:43
msgid "Behavior"
msgstr "Поведение"

#: preferences/page.js:45
msgid "Show workspaces"
msgstr "Показывать рабочие места"

#: preferences/page.js:45
msgid "Switch workspaces beside the launcher"
msgstr "Переключайте рабочие места рядом с меню приложений"

#: preferences/page.js:46
msgid "Always visible"
msgstr "Всегда видимый"

#: preferences/page.js:46
msgid "Show the dock over fullscreen windows"
msgstr "Показывать док поверх полноэкранных окон"

#: preferences/page.js:47
msgid "Click to minimize"
msgstr "Нажатие для сворачивания"

#: preferences/page.js:47
msgid "When a single window is already focused"
msgstr "Когда единственное окно уже в фокусе"

#: preferences/page.js:48
msgid "Animations"
msgstr "Анимации"

#: preferences/page.js:48
msgid "Raise app icons on hover"
msgstr "Приподнимать значки при наведении"

#: preferences/page.js:55
msgid "Keyboard and mouse"
msgstr "Клавиатура и мышь"

#: preferences/page.js:56
msgid ""
"Right-click: app menu. Middle-click: new window. Scroll: switch windows."
msgstr ""
"Правая кнопка: меню приложения. Средняя: новое окно. Прокрутка: переключение "
"окон."

#: preferences/page.js:57
msgid "Super key: app menu"
msgstr "Клавиша Super: меню приложений"

#: preferences/page.js:58
msgid ""
"Press Super to toggle search. Super + W opens the GNOME overview by default."
msgstr ""
"Super открывает или закрывает поиск. Super + W по умолчанию открывает обзор "
"GNOME."

#: preferences/page.js:60
msgid "Additional search shortcut"
msgstr "Дополнительное сочетание для поиска"

#: preferences/page.js:61
msgid "Overview shortcut"
msgstr "Сочетание для обзора"

#: preferences/page.js:77
msgid "Custom shortcuts"
msgstr "Свои сочетания клавиш"

#: preferences/page.js:78
msgid ""
"Example: &lt;Super&gt;w. Leave blank to disable the shortcut. Super alone "
"always opens the app menu."
msgstr ""
"Пример: &lt;Super&gt;w. Оставьте пустым, чтобы отключить сочетание. Одна "
"клавиша Super всегда открывает меню приложений."
