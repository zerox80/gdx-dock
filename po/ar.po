#: dock/appButton.js:90
#, javascript-format
msgid "%s — windows: %d"
msgstr "%s — النوافذ: %d"

#: dock/appMenu.js:34
msgid "Open"
msgstr "فتح"

#: dock/appMenu.js:36
msgid "New window"
msgstr "نافذة جديدة"

#: dock/appMenu.js:45 search/launcher.js:212
msgid "Unpin from dock"
msgstr "إلغاء التثبيت من الشريط"

#: dock/appMenu.js:45 search/launcher.js:212
msgid "Pin to dock"
msgstr "تثبيت في الشريط"

#: dock/appMenu.js:55 dock/appMenu.js:58
msgid "Move right"
msgstr "نقل إلى اليمين"

#: dock/appMenu.js:55 dock/appMenu.js:58
msgid "Move left"
msgstr "نقل إلى اليسار"

#: dock/appMenu.js:64
msgid "Close all windows"
msgstr "إغلاق كل النوافذ"

#: dock/appStrip.js:89
msgid "Your apps · pin them from search"
msgstr "تطبيقاتك · ثبّتها من البحث"

#: dock/workspaces.js:30
#, javascript-format
msgid "Workspace %d"
msgstr "مساحة العمل %d"

#: search/launcher.js:18
msgid "Search apps"
msgstr "البحث عن تطبيقات"

#: search/launcher.js:23
msgid "Apps"
msgstr "التطبيقات"

#: search/launcher.js:51
msgid "A great start."
msgstr "بداية رائعة."

#: search/launcher.js:52
msgid "Your apps. One place."
msgstr "تطبيقاتك. في مكان واحد."

#: search/launcher.js:55
msgid "GDX Dock settings"
msgstr "إعدادات GDX Dock"

#: search/launcher.js:65
msgid "Search for an app…"
msgstr "ابحث عن تطبيق…"

#: search/launcher.js:72
msgid "All apps"
msgstr "كل التطبيقات"

#: search/launcher.js:72
msgid "Pinned"
msgstr "المثبّتة"

#: search/launcher.js:72 search/launcher.js:202
msgid "Running"
msgstr "قيد التشغيل"

#: search/launcher.js:93
msgid "Up/Down: Select; Enter: Open"
msgstr "أعلى/أسفل: تحديد؛ إدخال: فتح"

#: search/launcher.js:94
msgid "Super · App menu"
msgstr "Super · قائمة التطبيقات"

#: search/launcher.js:187
#, javascript-format
msgid "Results: %d"
msgstr "النتائج: %d"

#: search/launcher.js:187
#, javascript-format
msgid "Apps: %d"
msgstr "التطبيقات: %d"

#: search/launcher.js:202
msgid "Application"
msgstr "تطبيق"

#: search/launcher.js:212
#, javascript-format
msgid "%s: %s"
msgstr "%s: %s"

#: search/launcher.js:230
msgid "No matching apps."
msgstr "لا توجد تطبيقات مطابقة."

#: search/launcher.js:230
msgid "Nothing here yet."
msgstr "لا شيء هنا بعد."

#: search/launcher.js:232
msgid "Try another name or search term."
msgstr "جرّب اسمًا أو عبارة بحث أخرى."

#: search/launcher.js:232
msgid "Use the star to pin apps to your dock."
msgstr "استخدم النجمة لتثبيت التطبيقات في الشريط."

#: search/launcher.js:237
msgid "Search to find more apps."
msgstr "ابحث للعثور على المزيد من التطبيقات."

#: preferences/page.js:9
msgid "Appearance"
msgstr "المظهر"

#: preferences/page.js:10
msgid "Changes apply immediately."
msgstr "تُطبّق التغييرات فورًا."

#: preferences/page.js:11
msgid "Icon size"
msgstr "حجم الأيقونات"

#: preferences/page.js:11
msgid "Small to large"
msgstr "من صغير إلى كبير"

#: preferences/page.js:15
msgid "Text size"
msgstr "حجم النص"

#: preferences/page.js:15
msgid "Percent of the default size"
msgstr "النسبة المئوية للحجم الافتراضي"

#: preferences/page.js:19
msgid "System icon size"
msgstr "حجم أيقونات النظام"

#: preferences/page.js:20
msgid "Wi-Fi, sound, battery and other status icons"
msgstr "الواي فاي والصوت والبطارية وأيقونات الحالة الأخرى"

#: preferences/page.js:24
msgid "Opacity"
msgstr "العتامة"

#: preferences/page.js:24
msgid "Percent"
msgstr "النسبة المئوية"

#: preferences/page.js:29
msgid "Accent color"
msgstr "لون التمييز"

#: preferences/page.js:30
msgid "Mint"
msgstr "نعناعي"

#: preferences/page.js:30
msgid "Lilac"
msgstr "ليلكي"

#: preferences/page.js:30
msgid "Blue"
msgstr "أزرق"

#: preferences/page.js:43
msgid "Behavior"
msgstr "السلوك"

#: preferences/page.js:45
msgid "Show workspaces"
msgstr "إظهار مساحات العمل"

#: preferences/page.js:45
msgid "Switch workspaces beside the launcher"
msgstr "بدّل مساحات العمل بجانب مشغّل التطبيقات"

#: preferences/page.js:46
msgid "Always visible"
msgstr "ظاهر دائمًا"

#: preferences/page.js:46
msgid "Show the dock over fullscreen windows"
msgstr "إظهار الشريط فوق نوافذ ملء الشاشة"

#: preferences/page.js:47
msgid "Click to minimize"
msgstr "النقر للتصغير"

#: preferences/page.js:47
msgid "When a single window is already focused"
msgstr "عندما تكون نافذة واحدة في موضع التركيز بالفعل"

#: preferences/page.js:48
msgid "Animations"
msgstr "الحركات"

#: preferences/page.js:48
msgid "Raise app icons on hover"
msgstr "رفع أيقونات التطبيقات عند مرور المؤشر"

#: preferences/page.js:55
msgid "Keyboard and mouse"
msgstr "لوحة المفاتيح والفأرة"

#: preferences/page.js:56
msgid ""
"Right-click: app menu. Middle-click: new window. Scroll: switch windows."
msgstr ""
"النقر الأيمن: قائمة التطبيق. النقر الأوسط: نافذة جديدة. التمرير: تبديل "
"النوافذ."

#: preferences/page.js:57
msgid "Super key: app menu"
msgstr "مفتاح Super: قائمة التطبيقات"

#: preferences/page.js:58
msgid ""
"Press Super to toggle search. Super + W opens the GNOME overview by default."
msgstr "يفتح Super البحث أو يغلقه. يفتح Super + W نظرة GNOME العامة افتراضيًا."

#: preferences/page.js:60
msgid "Additional search shortcut"
msgstr "اختصار إضافي للبحث"

#: preferences/page.js:61
msgid "Overview shortcut"
msgstr "اختصار النظرة العامة"

#: preferences/page.js:77
msgid "Custom shortcuts"
msgstr "اختصارات مخصصة"

#: preferences/page.js:78
msgid ""
"Example: &lt;Super&gt;w. Leave blank to disable the shortcut. Super alone "
"always opens the app menu."
msgstr ""
"مثال: &lt;Super&gt;w. اتركه فارغًا لتعطيل الاختصار. يفتح Super وحده قائمة "
"التطبيقات دائمًا."
