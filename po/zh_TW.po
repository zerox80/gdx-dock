msgstr "向左移動"

#: dock/appMenu.js:64
msgid "Close all windows"
msgstr "關閉所有視窗"

#: dock/appStrip.js:89
msgid "Your apps · pin them from search"
msgstr "你的應用程式 · 透過搜尋釘選"

#: dock/workspaces.js:30
#, javascript-format
msgid "Workspace %d"
msgstr "工作區 %d"

