#: dock/appButton.js:90
#, javascript-format
msgid "%s — windows: %d"
msgstr "%s — finestre: %d"

#: dock/appMenu.js:34
msgid "Open"
msgstr "Apri"

#: dock/appMenu.js:36
msgid "New window"
msgstr "Nuova finestra"

#: dock/appMenu.js:45 search/launcher.js:199
msgid "Unpin from dock"
msgstr "Rimuovi dal dock"

#: dock/appMenu.js:45 search/launcher.js:199
msgid "Pin to dock"
msgstr "Aggiungi al dock"

#: dock/appMenu.js:55 dock/appMenu.js:58
msgid "Move right"
msgstr "Sposta a destra"

#: dock/appMenu.js:55 dock/appMenu.js:58
msgid "Move left"
msgstr "Sposta a sinistra"

#: dock/appMenu.js:64
msgid "Close all windows"
msgstr "Chiudi tutte le finestre"

#: dock/appStrip.js:89
msgid "Your apps · pin them from search"
msgstr "Le tue app · aggiungile dalla ricerca"

#: dock/workspaces.js:30
#, javascript-format
msgid "Workspace %d"
msgstr "Spazio di lavoro %d"

#: search/launcher.js:18
msgid "Search apps"
msgstr "Cerca app"

#: search/launcher.js:23
msgid "Apps"
msgstr "App"

#: search/launcher.js:50
msgid "A great start."
msgstr "Un ottimo inizio."

#: search/launcher.js:51
msgid "Your apps. One place."
msgstr "Le tue app. Un unico posto."

#: search/launcher.js:54
msgid "GDX Dock settings"
msgstr "Impostazioni di GDX Dock"

#: search/launcher.js:64
msgid "Search for an app…"
msgstr "Cerca un’app…"

#: search/launcher.js:71
msgid "All apps"
msgstr "Tutte le app"

#: search/launcher.js:71
msgid "Pinned"
msgstr "Fissate"

#: search/launcher.js:71 search/launcher.js:189
msgid "Running"
msgstr "In esecuzione"

#: search/launcher.js:92
msgid "Up/Down: Select; Enter: Open"
msgstr "Su/Giù: seleziona; Invio: apri"

#: search/launcher.js:93
msgid "Super · App menu"
msgstr "Super · Menu delle app"

#: search/launcher.js:174
#, javascript-format
msgid "Results: %d"
msgstr "Risultati: %d"

#: search/launcher.js:174
#, javascript-format
msgid "Apps: %d"
msgstr "App: %d"

#: search/launcher.js:189
msgid "Application"
msgstr "Applicazione"

#: search/launcher.js:199
#, javascript-format
msgid "%s: %s"
msgstr "%s: %s"

#: search/launcher.js:217
msgid "No matching apps."
msgstr "Nessuna app corrispondente."

#: search/launcher.js:217
msgid "Nothing here yet."
msgstr "Non c’è ancora nulla qui."

#: search/launcher.js:219
msgid "Try another name or search term."
msgstr "Prova un altro nome o termine di ricerca."

#: search/launcher.js:219
msgid "Use the star to pin apps to your dock."
msgstr "Usa la stella per aggiungere app al dock."

#: search/launcher.js:224
msgid "Search to find more apps."
msgstr "Cerca per trovare altre app."

#: preferences/page.js:9
msgid "Appearance"
msgstr "Aspetto"

#: preferences/page.js:10
msgid "Changes apply immediately."
msgstr "Le modifiche vengono applicate subito."

#: preferences/page.js:11
msgid "Icon size"
msgstr "Dimensione delle icone"

#: preferences/page.js:11
msgid "Small to large"
msgstr "Da piccola a grande"

#: preferences/page.js:15
msgid "Opacity"
msgstr "Opacità"

#: preferences/page.js:15
msgid "Percent"
msgstr "Percentuale"

#: preferences/page.js:20
msgid "Accent color"
msgstr "Colore di accento"

#: preferences/page.js:21
msgid "Mint"
msgstr "Menta"

#: preferences/page.js:21
msgid "Lilac"
msgstr "Lilla"

#: preferences/page.js:21
msgid "Blue"
msgstr "Blu"

#: preferences/page.js:34
msgid "Behavior"
msgstr "Comportamento"

#: preferences/page.js:36
msgid "Show workspaces"
msgstr "Mostra spazi di lavoro"

#: preferences/page.js:36
msgid "Switch workspaces beside the launcher"
msgstr "Cambia spazio di lavoro accanto al lanciatore"

#: preferences/page.js:37
msgid "Always visible"
msgstr "Sempre visibile"

#: preferences/page.js:37
msgid "Show the dock over fullscreen windows"
msgstr "Mostra il dock sopra le finestre a schermo intero"

#: preferences/page.js:38
msgid "Click to minimize"
msgstr "Clic per minimizzare"

#: preferences/page.js:38
msgid "When a single window is already focused"
msgstr "Quando una sola finestra ha già il focus"

#: preferences/page.js:39
msgid "Animations"
msgstr "Animazioni"

#: preferences/page.js:39
msgid "Raise app icons on hover"
msgstr "Solleva le icone al passaggio del puntatore"

#: preferences/page.js:46
msgid "Keyboard and mouse"
msgstr "Tastiera e mouse"

#: preferences/page.js:47
msgid ""
"Right-click: app menu. Middle-click: new window. Scroll: switch windows."
msgstr ""
"Clic destro: menu dell’app. Clic centrale: nuova finestra. Scorrimento: "
"cambia finestra."

#: preferences/page.js:48
msgid "Super key: app menu"
msgstr "Tasto Super: menu delle app"

#: preferences/page.js:49
msgid ""
"Press Super to toggle search. Super + W opens the GNOME overview by default."
msgstr ""
"Super apre o chiude la ricerca. Super + W apre la panoramica di GNOME per "
"impostazione predefinita."

#: preferences/page.js:51
msgid "Additional search shortcut"
msgstr "Scorciatoia di ricerca aggiuntiva"

#: preferences/page.js:52
msgid "Overview shortcut"
msgstr "Scorciatoia della panoramica"

#: preferences/page.js:68
msgid "Custom shortcuts"
msgstr "Scorciatoie personalizzate"

#: preferences/page.js:69
msgid ""
"Example: &lt;Super&gt;w. Leave blank to disable the shortcut. Super alone "
"always opens the app menu."
msgstr ""
"Esempio: &lt;Super&gt;w. Lascia vuoto per disabilitare la scorciatoia. Super "
"da solo apre sempre il menu delle app."
